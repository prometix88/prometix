{
  "hooks": {
    "before:init": ["npm run build"],
    "after:bump": ["npm run build", "node scripts/verify-bundle-version.mjs ${version}"]
  },
  "git": {
    "commitMessage": "release: v${version}",
    "tagName": "v${version}",
    "requireCommits": true,
    "commitArgs": ["--no-verify"],
    "requireUpstream": true
  },
  "npm": {
    "publish": true
  },
  "github": {
    "release": true
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "header": "# Changelog",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "Features"
          },
          {
            "type": "fix",
            "section": "Bug Fixes"
          }
        ]
      }
    }
  }
}
